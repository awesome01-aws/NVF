<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#065f46" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>
    <linearGradient id="eggGrad" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
    <linearGradient id="leafGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="10" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Dark Emerald Rounded Badge Background -->
  <rect x="16" y="16" width="480" height="480" rx="112" fill="url(#bgGrad)" />

  <!-- Outer Ring Accent -->
  <rect x="28" y="28" width="456" height="456" rx="100" fill="none" stroke="#10b981" stroke-width="8" stroke-opacity="0.3" />

  <!-- Stylized Green Leaves / Wings flanking the Egg -->
  <path d="M 120 280 C 100 200, 160 140, 220 180 C 180 230, 160 300, 180 360 Z" fill="url(#leafGrad)" opacity="0.9" />
  <path d="M 392 280 C 412 200, 352 140, 292 180 C 332 230, 352 300, 332 360 Z" fill="url(#leafGrad)" opacity="0.9" />

  <!-- Central Golden Hatching Egg -->
  <path d="M 256 120 C 180 120, 140 230, 140 330 C 140 400, 190 430, 256 430 C 322 430, 372 400, 372 330 C 372 230, 332 120, 256 120 Z" fill="url(#eggGrad)" />

  <!-- Egg Shine Highlight -->
  <path d="M 220 160 C 200 180, 180 230, 175 280 C 170 300, 185 300, 190 280 C 200 230, 220 190, 238 172 C 245 165, 230 152, 220 160 Z" fill="#ffffff" opacity="0.5" />

  <!-- Small Rising Sun Rays above Egg (Vision Theme) -->
  <circle cx="256" cy="80" r="14" fill="#fbbf24" />
  <line x1="256" y1="46" x2="256" y2="56" stroke="#fbbf24" stroke-width="6" stroke-linecap="round" />
  <line x1="226" y1="56" x2="233" y2="63" stroke="#fbbf24" stroke-width="6" stroke-linecap="round" />
  <line x1="286" y1="56" x2="279" y2="63" stroke="#fbbf24" stroke-width="6" stroke-linecap="round" />
</svg>
